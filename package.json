{
  "name": "rlogs-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/check-optimizer-wasm.mjs && vite build && node scripts/check-built-routes.mjs",
    "check": "tsc -b --pretty false && node scripts/check-optimizer-wasm.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "smoke:production-profiles": "node scripts/audit-live-profile-presentation.mjs",
    "profile:publish": "node scripts/publish-profile.ts",
    "profile:catalog": "node scripts/generate-profile-presentation.mjs",
    "parse:catalog": "node scripts/generate-parse-presentation.mjs && node scripts/generate-parse-presentation-v5.mjs"
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-alpha.3",
    "@emnapi/runtime": "2.0.0-alpha.3",
    "@types/node": "26.1.2",
    "happy-dom": "20.8.9",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.11"
  }
}
